# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=guardian

# Application
PORT=3000
NODE_ENV=development

# Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Security & Auth
JWT_SECRET=guardian-super-secure-jwt-secret-key-32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=*

# Firebase Admin SDK (Opcional para push notifications reales)
# Dejar vacío o no definir para modo Dry-Run / Simulado automático
# FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

